<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPhone.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            

            <Label
                Text="Skeniranje kosilica:"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Sistem za skeniranje kosilica"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level3"
                SemanticProperties.Description="Sistem za skeniranje" />

            <Button
                x:Name="RedirectQr"
                Text="Skeniraj kosilice" 
                SemanticProperties.Hint="Otvara novu stranicu"
                Clicked="Redirect"
                HorizontalOptions="CenterAndExpand" />
            <Button
                x:Name="RedirectHttp"
                Text="Http Test" 
                SemanticProperties.Hint="Otvara novu stranicu"
                Clicked="HttpRedirect"
                HorizontalOptions="CenterAndExpand" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
